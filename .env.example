# Pick one backend. With no key at all the app still runs on a free,
# tone-blind fallback (MyMemory): no live partials, no tone, no back-translation.

# Option A: any OpenAI-compatible API. Groq is the default: fast, has a free tier.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Option B: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

PORT=3000
